# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.linjectables.co.nz

# ---- Sanity CMS ----
# Leave blank to run the site from the built-in seed content (src/content/seed.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Read token only needed if the dataset is private. Write token only needed for `npm run seed:sanity`.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook -> /api/revalidate (instant publish)
SANITY_REVALIDATE_SECRET=

# ---- Enquiry form ----
# Resend (https://resend.com). Without a key, enquiries are logged to the server console only.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@linjectables.co.nz
ENQUIRY_FROM_EMAIL=LINJECTABLES Website <website@linjectables.co.nz>
# Optional Cloudflare Turnstile spam protection (honeypot + timing check always on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
